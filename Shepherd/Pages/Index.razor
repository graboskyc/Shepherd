@page "/"
@page "/home"
@using System.Security.Claims;

<PageTitle>Home - Codename Shepherd</PageTitle>

<AuthorizeView>
    <Authorized>   
       <h1>Getting Started</h1>
       <h2>Welcome, @UI.Name. How should we begin?</h2>
       
        <div class="grid">
          <div>
            <article>
                <header>Tasks</header>
                <p>Create a task-based signup</p>
                <p>Think about "what is everyone bringing to the party"</p>
                <p><i>Available as public preview</i></p>
                
                <a href="/Manage/TaskBasedList">
                  <ClipboardGraphic Width="200" Height="200" />
                </a>
            </article>
          </div>
          <div>
            <article>
                <header>Dates & Times</header>
                <p>Create a time-based signup</p>
                <p>Think about "who is covering which volunteer shift"</p>
                <p><i>Coming soon...</i></p>
                
                <ClockGraphic Width="200" Height="200" />

            </article>
          </div>
          <div>
            <article>
                <header>RSVP</header>
                <p>Create a basic signup</p>
                <p>Think about "who is coming"</p>
                <p><i>Coming soon...</i></p>
                
                <PersonGraphic Width="200" Height="200" />

            </article>
          </div>
        </div>
    </Authorized>
    <NotAuthorized>
        <h1>Codename Shepherd</h1>

        <div style="text-align: center;">
          <img src="/img/icon.png" />
        </div>
    </NotAuthorized>
</AuthorizeView>

@code {
    [CascadingParameter]
    private Task<AuthenticationState>? authenticationState { get; set; }
    private UserInfo UI = new UserInfo();

    protected override async Task OnInitializedAsync()  {

      if (authenticationState is not null) {
        var state = await authenticationState;
        UI.Name = state?.User?.Identity?.Name ?? string.Empty;
        UI.Email = state?.User?.Claims.FirstOrDefault(c => c.Type == ClaimTypes.Email)?.Value;
        UI.UserId = state?.User?.Claims.FirstOrDefault(c => c.Type == ClaimTypes.NameIdentifier)?.Value;
      }
    }
}
