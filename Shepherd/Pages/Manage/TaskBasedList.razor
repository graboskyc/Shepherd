@page "/Manage/TaskBasedList"
@using System.Security.Claims;
@using MongoDB.Bson;
@using MongoDB.Driver;
@using Shepherd.Data;
@inject IMongoCollection<HerdingList> HLCollection;
@inject NavigationManager Navigation;
@using Microsoft.FluentUI.AspNetCore.Components;
@inject IJSRuntime JSRuntime;

<PageTitle>Task Based - Codename Shepherd</PageTitle>

<AuthorizeView>
    <Authorized>   
       <h1>Getting Started</h1>
       <p><a role="button" href="/Manage/TaskBasedEdit">Create New</a></p>
        @if(_hlList != null) {
            @foreach(var hl in _hlList) {
              <article>
                <header></header>
                <p><FluentIcon Color="Color.Custom" CustomColor="#647687" Value="@(new Icons.Regular.Size20.AnimalCat())" /> @hl.Name</p>
                <p><FluentIcon Color="Color.Custom" CustomColor="#647687" Value="@(new Icons.Regular.Size20.Calendar())" /> @hl.EventDT</p>
                <p><FluentIcon Color="Color.Custom" CustomColor="#647687" Value="@(new Icons.Regular.Size20.AppsList())" /> @hl.Slots.Count slots with @hl.TotalQuantities total quantity</p>
                <p><FluentIcon Color="Color.Custom" CustomColor="#647687" Value="@(new Icons.Regular.Size20.People())" /> @hl.TotalSignups signups</p>
                @if(hl.IsPublished) {
                  <p><FluentIcon Color="Color.Custom" CustomColor="#647687" Value="@(new Icons.Regular.Size20.CheckboxChecked())" /> published</p>
                } else {
                  <p><FluentIcon Color="Color.Custom" CustomColor="#647687" Value="@(new Icons.Regular.Size20.BorderNone())" /> unpublished</p>
                }
                <p>
                  <a role="button" class="outline" href="/Manage/TaskBasedEdit/@hl.Id.ToString()" data-tooltip="Edit">
                    <FluentIcon Color="Color.Custom" CustomColor="#647687" Value="@(new Icons.Regular.Size20.Edit())" />
                  </a>
                  @if(hl.IsPublished) {
                    <span>&nbsp;</span>
                    <a role="button" class="outline" href="/Manage/Report/@hl.Id.ToString()" data-tooltip="Report">
                      <FluentIcon Color="Color.Custom" CustomColor="#647687" Value="@(new Icons.Regular.Size20.ClipboardBulletList())" />
                    </a>
                    <span>&nbsp;</span>
                    <button class="outline" data-tooltip="Copy to Clipboard" @onclick="(() => CopyToClip(hl.Id.ToString()))">
                      <FluentIcon Color="Color.Custom" CustomColor="#647687" Value="@(new Icons.Regular.Size20.Copy())" />
                    </button>
                  }
                </p>
              </article>
            }
        }
    </Authorized>
    <NotAuthorized>
        <h1>Codename Shepherd</h1>

        <p>You must sign in</p>
    </NotAuthorized>
</AuthorizeView>

<Toast Message="Link Copied to Clipboard" Show=showToast>
  <FluentIcon Color="Color.Custom" CustomColor="#647687" Value="@(new Icons.Regular.Size20.Copy())" />
</Toast>

@code {
    [CascadingParameter]
    private Task<AuthenticationState>? authenticationState { get; set; }
    private UserInfo UI = new UserInfo();
    private List<HerdingList> _hlList = null;
    private bool showToast = false;

    protected override async Task OnInitializedAsync()  {

      if (authenticationState is not null) {
        var state = await authenticationState;
        UI.Name = state?.User?.Identity?.Name ?? string.Empty;
        UI.Email = state?.User?.Claims.FirstOrDefault(c => c.Type == ClaimTypes.Email)?.Value;
        UI.UserId = state?.User?.Claims.FirstOrDefault(c => c.Type == ClaimTypes.NameIdentifier)?.Value;
      }

      FilterDefinition<HerdingList> filter = Builders<HerdingList>.Filter.Eq("ownedBy", UI.UserId);
      _hlList = await HLCollection.Find(filter).ToListAsync();
    }

    private async Task CopyToClip(string id) {
      await JSRuntime.InvokeVoidAsync("navigator.clipboard.writeText", "https://www.catshepherd.lol/SignUp/"+id);
      showToast = true;
    }
}
