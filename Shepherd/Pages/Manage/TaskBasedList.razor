@page "/Manage/TaskBasedList"
@using System.Security.Claims;
@using MongoDB.Bson;
@using MongoDB.Driver;
@using Shepherd.Data;
@inject IMongoCollection<HerdingList> HLCollection;
@inject NavigationManager Navigation;
@using Microsoft.FluentUI.AspNetCore.Components;

<PageTitle>Task Based - Codename Shepherd</PageTitle>

<AuthorizeView>
    <Authorized>   
       <h1>Getting Started</h1>
       <p><a role="button" href="/Manage/TaskBasedEdit">Create New</a></p>
        @if(_hlList != null) {
            @foreach(var hl in _hlList) {
              <article>
                <header></header>
                <p><FluentIcon Value="@(new Icons.Regular.Size20.AnimalCat())" /> @hl.Name</p>
                <p><FluentIcon Value="@(new Icons.Regular.Size20.Calendar())" /> @hl.EventDT</p>
                <p><FluentIcon Value="@(new Icons.Regular.Size20.AppsList())" /> @hl.Slots.Count items</p>
                <p><FluentIcon Value="@(new Icons.Regular.Size20.People())" /> signups</p>
                @if(hl.IsPublished) {
                  <p><FluentIcon Value="@(new Icons.Regular.Size20.CheckboxChecked())" /> published</p>
                } else {
                  <p><FluentIcon Value="@(new Icons.Regular.Size20.BorderNone())" /> unpublished</p>
                }
                <p>
                  <a role="button" class="outline" href="/Manage/TaskBasedEdit/@hl.Id.ToString()">Edit</a>
                  &nbsp;
                  <a role="button" class="outline" href="/Manage/Report/@hl.Id.ToString()">Report</a>
                </p>
              </article>
            }
        }
    </Authorized>
    <NotAuthorized>
        <h1>Codename Shepherd</h1>

        <p>You must sign in</p>
    </NotAuthorized>
</AuthorizeView>

@code {
    [CascadingParameter]
    private Task<AuthenticationState>? authenticationState { get; set; }
    private UserInfo UI = new UserInfo();
    private List<HerdingList> _hlList = null;

    protected override async Task OnInitializedAsync()  {

      if (authenticationState is not null) {
        var state = await authenticationState;
        UI.Name = state?.User?.Identity?.Name ?? string.Empty;
        UI.Email = state?.User?.Claims.FirstOrDefault(c => c.Type == ClaimTypes.Email)?.Value;
        UI.UserId = state?.User?.Claims.FirstOrDefault(c => c.Type == ClaimTypes.NameIdentifier)?.Value;
      }

      FilterDefinition<HerdingList> filter = Builders<HerdingList>.Filter.Eq("ownedBy", UI.UserId);
      _hlList = await HLCollection.Find(filter).ToListAsync();
    }
}
