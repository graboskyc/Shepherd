@page "/Manage/TaskBasedEdit"
@page "/Manage/TaskBasedEdit/{Id}"
@using System.Security.Claims;
@using MongoDB.Bson;
@using MongoDB.Driver;
@using Shepherd.Data;
@inject IMongoCollection<HerdingList> HLCollection;
@inject NavigationManager Navigation;
@using Microsoft.FluentUI.AspNetCore.Components;
@inject IJSRuntime JSRuntime;

<PageTitle>Task Based - Codename Shepherd</PageTitle>

<AuthorizeView Context="Auth">
    <Authorized>   
      @if(hl != null) {
        <EditForm Model="hl">
          <h1>
            <FluentIcon 
              Color="Color.Custom" 
              CustomColor="#647687" 
              Value="@(new Icons.Regular.Size20.ArrowStepBack())" 
              @onclick="GoBack" />
            Edit <i>@hl.Name</i>
          </h1>

          <article>
            <header>Basic Information</header>

            <label>Name</label>
            <input type="text" @bind="hl.Name" disabled="@hl.IsPublished" />

            @if(!hl.IsPublished) {
              <label>Description</label>
              <InputTextArea @bind-Value="@hl.Description" rows="3"></InputTextArea>

              <label>Location</label>
              <input type="text" @bind="hl.Location" />

              <label>Event Date and Time</label>
              <input type="datetime-local" name="datetime-local" aria-label="Datetime local" @bind="hl.EventDT">

              <label>Stop Accepting Startups</label>
              <input type="datetime-local" name="datetime-local" aria-label="Datetime local" @bind="hl.EndSignupsDT">
            }

            <label>
              <input @bind="@hl.IsPublished" type="checkbox" role="switch" />
              Published
            </label>
          </article>

          <article>
            <header>Slots</header>

            @if(!hl.IsPublished) {

              @foreach(var slot in hl.Slots) {
                <article>
                  <header></header>

                  <label>Name</label>
                  <input type="text" @bind="slot.Name" />

                  <label data-tooltip="Number of participants">Quantity</label>
                  <input @bind="slot.Quantity" type="number" name="number" placeholder="Number" aria-label="Number">
                
                  <footer>
                    <button class="contrast" @onclick="(() => DelSlot(slot))">
                      Delete Slot
                    </button>
                  </footer>
                </article>
              }

              <footer>
                <button @onclick="AddSlot">Add Slot</button>
              </footer>
            } else {
              @foreach(var slot in hl.Slots) {
                <article>
                    <header>@slot.Name</header>

                    <table>
                      <thead>
                        <th>Name</th>
                        <th>Action</th>
                      </thead>
                      <tbody>
                        @foreach(var su in slot.SignUps) {
                          <tr>
                            <td>@su.WhoName</td>
                            <td><button @onclick="(() =>DelSignup(slot, su.WhoEmail))">Delete Signup</button></td>
                          </tr>
                        }
                      </tbody>
                    </table>
                </article>
              }
            }
          </article>

          <article>
            <header>Finish</header>
            <button type="submit" @onclick="Submit">Save</button>
          </article>

        </EditForm>
      } else {
        <span aria-busy="true">Loading...</span>
      }
    </Authorized>
    <NotAuthorized>
        <h1>Codename Shepherd</h1>

        <p>You must sign in</p>
    </NotAuthorized>
</AuthorizeView>

<Toast Message="Saved!" Show=showToast>
  <FluentIcon Color="Color.Custom" CustomColor="#647687" Value="@(new Icons.Regular.Size20.Info())" />
</Toast>

@code {
    [CascadingParameter]
    private Task<AuthenticationState>? authenticationState { get; set; }
    [Parameter]
    public string Id {get;set;} = null;
    private UserInfo UI = new UserInfo();
    private HerdingList hl = null;
    private bool showToast = false;

    protected override async Task OnInitializedAsync()  {

      if (authenticationState is not null) {
        var state = await authenticationState;
        UI.Name = state?.User?.Identity?.Name ?? string.Empty;
        UI.Email = state?.User?.Claims.FirstOrDefault(c => c.Type == ClaimTypes.Email)?.Value;
        UI.UserId = state?.User?.Claims.FirstOrDefault(c => c.Type == ClaimTypes.NameIdentifier)?.Value;

        if(string.IsNullOrEmpty(Id)) {
          hl = new HerdingList();
          hl.Id = ObjectId.GenerateNewId();
          hl.OwnedBy = UI.UserId;
          hl.Name = UI.Name + " new event";
          HLCollection.InsertOne(hl);
          Navigation.NavigateTo("/Manage/TaskBasedEdit/"+hl.Id.ToString(),true);
          Id = hl.Id.ToString();
        } else {
          var builder = Builders<HerdingList>.Filter;
          var filter = builder.Empty;
          filter &= builder.Eq("_id", new ObjectId(Id));
          filter &= builder.Eq("ownedBy", UI.UserId);
          var hls = await HLCollection.Find(filter).ToListAsync();
          hl = hls.FirstOrDefault();
        }


      }

    }

    private async Task Submit() {
      hl.ModifiedDT = DateTime.Now;
      FilterDefinition<HerdingList> filter = Builders<HerdingList>.Filter.Eq("_id", new ObjectId(Id));
      await HLCollection.ReplaceOneAsync(filter, hl);
      showToast = true;
    }

    private void AddSlot() {
      var s = new HerdingListSlot();
      hl.Slots.Add(s);
    }

    private void DelSlot(HerdingListSlot s) {
      hl.Slots.RemoveAll(slot => slot.Id == s.Id);
      StateHasChanged();
    }

    private async Task DelSignup(HerdingListSlot s, string email) {
      foreach(var slot in hl.Slots) {
        if(slot.Id == s.Id) {
          slot.SignUps.RemoveAll(su => su.WhoEmail == email);
          StateHasChanged();
        }
      }
      await Submit();
    }

    private async Task GoBack() {
      await JSRuntime.InvokeVoidAsync("history.back");
    }
}
