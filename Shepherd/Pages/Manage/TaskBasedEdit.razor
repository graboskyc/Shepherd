@page "/Manage/TaskBasedEdit"
@page "/Manage/TaskBasedEdit/{Id}"
@using System.Security.Claims;
@using MongoDB.Bson;
@using MongoDB.Driver;
@using Shepherd.Data;
@inject IMongoCollection<HerdingList> HLCollection;
@inject NavigationManager Navigation;

<PageTitle>Task Based - Codename Shepherd</PageTitle>

<AuthorizeView Context="Auth">
    <Authorized>   
      <h1>Getting Started</h1>
      @if(hl != null) {
        <EditForm Model="hl">
          <label>Name</label>
          <input type="text" @bind="hl.Name" />

          <button type="submit">Save</button>
        </EditForm>
      }
    </Authorized>
    <NotAuthorized>
        <h1>Codename Shepherd</h1>

        <p>You must sign in</p>
    </NotAuthorized>
</AuthorizeView>

@code {
    [CascadingParameter]
    private Task<AuthenticationState>? authenticationState { get; set; }
    [Parameter]
    public string Id {get;set;} = null;
    private UserInfo UI = new UserInfo();
    private HerdingList hl = null;

    protected override async Task OnInitializedAsync()  {

      if (authenticationState is not null) {
        var state = await authenticationState;
        UI.Name = state?.User?.Identity?.Name ?? string.Empty;
        UI.Email = state?.User?.Claims.FirstOrDefault(c => c.Type == ClaimTypes.Email)?.Value;
        UI.UserId = state?.User?.Claims.FirstOrDefault(c => c.Type == ClaimTypes.NameIdentifier)?.Value;
      }

      if(string.IsNullOrEmpty(Id)) {
        hl = new HerdingList();
        hl.Id = ObjectId.GenerateNewId();
        hl.OwnedBy = UI.UserId;
        hl.Name = UI.Name + " new task";
        HLCollection.InsertOne(hl);
        Navigation.NavigateTo("/Manage/TaskBasedEdit/"+hl.Id.ToString(),true);
        Id = hl.Id.ToString();
      } else {
        FilterDefinition<HerdingList> filter = Builders<HerdingList>.Filter.Eq("_id", new ObjectId(Id));
        var hls = await HLCollection.Find(filter).ToListAsync();
        hl = hls.FirstOrDefault();
      }
    }

    private async Task Submit() {
      FilterDefinition<HerdingList> filter = Builders<HerdingList>.Filter.Eq("_id", new ObjectId(Id));
      await HLCollection.ReplaceOneAsync(filter, hl);
    }
}
